# Checked-in render snapshots and documentation are compared as text with LF
# endings on every platform, so a Windows checkout cannot show a diff.
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.rs text eol=lf
*.yml text eol=lf

# Rust sources and the lockfile stay text; the binary fixtures under tests are
# not text and must be checked out byte-exactly.
Cargo.lock text eol=lf
*.png binary
